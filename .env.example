APP_NAME="VOX TECH GLOBAL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données ---------------------------------------------------
# Développement : SQLite (fichier database/database.sqlite)
DB_CONNECTION=sqlite
# Production (LWS, o2switch, VPS…) : MySQL / MariaDB
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=voxtech
# DB_USERNAME=voxtech
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "database" : les e-mails partent via la tâche planifiée (cron) ; "sync" : envoi immédiat
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- E-mails (SMTP de l'hébergeur, Brevo, Mailgun, Postmark…) ---------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.votre-hebergeur.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="redaction@voxtechglobal.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Compte administrateur créé par le seeder ----------------------------
ADMIN_EMAIL=admin@voxtechglobal.com
ADMIN_PASSWORD=VoxTech@2026
# Générer un historique d'audience de démonstration (mettre false en production)
SEED_DEMO_STATS=true
